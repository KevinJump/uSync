# Copy to .env to override the defaults. Everything here is optional.

# The site to test. When this is not set the tests start (or reuse) uSyncSource.Site
# on https://localhost:44398.
# UMBRACO_URL=https://localhost:44398

# Backoffice login. Defaults to the unattended install user, read from
# UMBRACO__CMS__UNATTENDED__UNATTENDEDUSEREMAIL / ...UNATTENDEDUSERPASSWORD.
# UMBRACO_USER_LOGIN=
# UMBRACO_USER_PASSWORD=
